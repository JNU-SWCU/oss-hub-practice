pipeline {
  agent any
  parameters { string(name: 'IMAGE_TAG', description: 'Immutable commit SHA') }
  stages {
    stage('Checkout') { steps { checkout scm } }
    stage('Build and push') { steps { sh 'docker compose build' } }
    stage('Deploy') { steps { sh 'docker compose up -d' } }
    stage('Health check') { steps { sh 'curl --fail http://localhost/health' } }
  }
  post { failure { sh 'docker compose logs --no-color --tail=100' } }
}
